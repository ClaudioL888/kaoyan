{"audit_id":"math2.lilin880.first-three-chapters.20260821","chapter_id":"math2.calculus.ch03","source_section":"高数第二章｜基础解答","source_pdf_pages":[142,143,144],"item_ref":"ch02.basic.solution.003","item_kind":"nonchoice","prompt":"求三类函数的微分：复合函数、隐函数、参数函数。","topic_tags":["微分","隐函数","参数方程"],"type_pool":"微分","subquestions":[{"label":"(I)","formal_answer":"dy=−φ'(arctan(1/x))/(1+x²) dx","official_analysis":"链式法则并化简 d(arctan(1/x))。","independent_check":"导数为 −1/(1+x²)。","status":"verified"},{"label":"(II)","formal_answer":"dy=[y cos x−e^(x+y)]/[e^(x+y)−sin x] dx","official_analysis":"对 e^(x+y)−y sin x=0 作全微分。","independent_check":"将 dy 项移至同侧。","status":"verified"},{"label":"(III)","formal_answer":"dy=(5/2)x dx","official_analysis":"x=2t，y=5t²+1，先消 t。","independent_check":"y=5x²/4+1。","status":"verified"}],"official_answer_source_pages":[42],"source_status":"题面文本层与答案视觉核验。","verification_status":"verified","reviewed_at":"2026-08-21T17:35:00+08:00","reviewed_by":"Codex"}
