{"id":"f.arithmetic.general","entity_kind":"formula","title":"等差通项","text":"a_n=a_1+(n-1)d","source_id":"src.math2.textbook_ch02","source_pages":[84],"confirmation":"source_page_confirmed","applicability_conditions":"n∈N+，d 为固定实数"}
{"id":"f.arithmetic.sum","entity_kind":"formula","title":"等差和","text":"S_n=\\frac n2[2a_1+(n-1)d]=\\frac n2(a_1+a_n)","source_id":"src.math2.textbook_ch02","source_pages":[84],"confirmation":"source_page_confirmed","applicability_conditions":"n∈N+，d 为固定实数"}
{"id":"f.geometric.general","entity_kind":"formula","title":"等比通项","text":"a_n=a_1r^{n-1}","source_id":"src.math2.textbook_ch02","source_pages":[84],"confirmation":"source_page_confirmed","applicability_conditions":"n∈N+，r≠0"}
{"id":"f.geometric.sum","entity_kind":"formula","title":"等比和","text":"S_n=\\begin{cases}na_1,&r=1\\\\\\frac{a_1(1-r^n)}{1-r},&r\\ne1\\end{cases}","source_id":"src.math2.textbook_ch02","source_pages":[84],"confirmation":"source_page_confirmed","applicability_conditions":"n∈N+；r=1 或 r≠1 分情况"}
{"id":"f.sum.k","entity_kind":"formula","title":"幂和","text":"\\sum_{k=1}^n k=\\frac{n(n+1)}2","source_id":"src.math2.textbook_ch02","source_pages":[84],"confirmation":"source_page_confirmed","applicability_conditions":"n∈N+"}
{"id":"f.sum.k2","entity_kind":"formula","title":"平方和","text":"\\sum_{k=1}^n k^2=\\frac{n(n+1)(2n+1)}6","source_id":"src.math2.textbook_ch02","source_pages":[84],"confirmation":"source_page_confirmed","applicability_conditions":"n∈N+"}
{"id":"f.sum.telescoping","entity_kind":"formula","title":"裂项和","text":"\\sum_{k=1}^n\\frac1{k(k+1)}=1-\\frac1{n+1}","source_id":"src.math2.textbook_ch02","source_pages":[84],"confirmation":"source_page_confirmed","applicability_conditions":"n∈N+"}
{"id":"f.limit.definition","entity_kind":"formula","title":"极限定义","text":"\\forall\\varepsilon>0,\\exists N\\in\\mathbb N_+,n>N\\Rightarrow|x_n-a|<\\varepsilon","source_id":"src.math2.textbook_ch02","source_pages":[85],"confirmation":"source_page_confirmed","applicability_conditions":"n∈N+，ε>0"}
{"id":"f.abs_limit","entity_kind":"formula","title":"绝对值极限","text":"\\lim x_n=A\\Rightarrow\\lim|x_n|=|A|","source_id":"src.math2.textbook_ch02","source_pages":[86],"confirmation":"source_page_confirmed","applicability_conditions":"a_n 收敛且极限 A 为有限实数"}
{"id":"f.limit.operations","entity_kind":"formula","title":"四则运算","text":"\\lim(x_n\\pm y_n)=a\\pm b,\\ \\lim(x_ny_n)=ab,\\ \\lim\\frac{x_n}{y_n}=\\frac ab\\ (b\\ne0)","source_id":"src.math2.textbook_ch02","source_pages":[88],"confirmation":"source_page_confirmed","applicability_conditions":"两序列极限均存在；商式还需 b≠0 且分母最终非零"}
{"id":"f.squeeze","entity_kind":"formula","title":"夹逼定理","text":"y_n\\le x_n\\le z_n,\\ \\lim y_n=\\lim z_n=a\\Rightarrow\\lim x_n=a","source_id":"src.math2.textbook_ch02","source_pages":[91],"confirmation":"source_page_confirmed","applicability_conditions":"不等式对充分大的 n 成立且两端极限相同"}
{"id":"f.squeeze.sum_bounds","entity_kind":"formula","title":"和式夹逼","text":"n u_{\\min}\\le\\sum_{i=1}^n u_i\\le n u_{\\max}","source_id":"src.math2.textbook_ch02","source_pages":[92],"confirmation":"source_page_confirmed","applicability_conditions":"u_i 非负且上下界对所有项统一有效"}
{"id":"f.contraction","entity_kind":"formula","title":"压缩映射","text":"|x_{n+1}-a|\\le k|x_n-a|,\\ 0<k<1\\Rightarrow x_n\\to a","source_id":"src.math2.textbook_ch02","source_pages":[97],"confirmation":"source_page_confirmed","applicability_conditions":"对所有 n 成立，0<k<1 且 a 为目标不动点"}
{"id":"f.speed_ratio","entity_kind":"formula","title":"速度比","text":"I=\\lim_{n\\to\\infty}\\frac{|x_n-a|}{|y_n-a|}","source_id":"src.math2.textbook_ch02","source_pages":[100],"confirmation":"source_page_confirmed","applicability_conditions":"分母序列最终非零且两误差均按极限定义比较"}
{"id":"f.common_ineq","entity_kind":"formula","title":"常用不等式","text":"\\sqrt{ab}\\le\\frac{a+b}{2},\\ |a\\pm b|\\le|a|+|b|","source_id":"src.math2.textbook_ch02","source_pages":[92],"confirmation":"source_page_confirmed","applicability_conditions":"根式部分 a,b≥0；绝对值部分 a,b 为实数"}
{"id":"f.trig_small","entity_kind":"formula","title":"等价无穷小","text":"1-\\cos x\\sim\\frac{x^2}{2}\\ (x\\to0)","source_id":"src.math2.textbook_ch02","source_pages":[94],"confirmation":"source_page_confirmed","applicability_conditions":"x→0"}
{"id":"f.amgm.two","entity_kind":"formula","title":"二元均值不等式","text":"\\sqrt{ab}\\le\\frac{a+b}{2}\\le\\sqrt{\\frac{a^2+b^2}{2}}","applicability_conditions":"a,b≥0","source_id":"src.math2.textbook_ch02","source_pages":[92],"confirmation":"source_page_confirmed"}
{"id":"f.amgm.three","entity_kind":"formula","title":"三元均值不等式","text":"\\sqrt[3]{abc}\\le\\frac{a+b+c}{3}\\le\\sqrt{\\frac{a^2+b^2+c^2}{3}}","applicability_conditions":"a,b,c≥0","source_id":"src.math2.textbook_ch02","source_pages":[92],"confirmation":"source_page_confirmed"}
{"id":"f.power.monotonic","entity_kind":"formula","title":"幂函数比较","text":"a>b>0,\\quad m>0\\Rightarrow a^m>b^m,\\quad m<0\\Rightarrow a^m<b^m","applicability_conditions":"a>b>0，m 为实数","source_id":"src.math2.textbook_ch02","source_pages":[92],"confirmation":"source_page_confirmed"}
{"id":"f.ratio.inequality","entity_kind":"formula","title":"比例不等式","text":"0<a<x<b,\\quad0<c<y<d\\Rightarrow\\frac{c}{b}<\\frac{y}{x}<\\frac{d}{a}","applicability_conditions":"所有分母与被比较量为正","source_id":"src.math2.textbook_ch02","source_pages":[92],"confirmation":"source_page_confirmed"}
{"id":"f.trig.bounds","entity_kind":"formula","title":"三角函数放缩","text":"\\sin x<x<\\tan x\\quad\\left(0<x<\\frac\\pi2\\right),\\qquad\\sin x<x\\quad(x>0)","applicability_conditions":"按括号内区间使用","source_id":"src.math2.textbook_ch02","source_pages":[92],"confirmation":"source_page_confirmed"}
{"id":"f.inverse_trig_bounds","entity_kind":"formula","title":"反三角函数不等式","text":"arctan x≤x≤arcsin x (0≤x≤1)","applicability_conditions":"0≤x≤1","source_id":"src.math2.textbook_ch02","source_pages":[93],"confirmation":"source_page_confirmed"}
{"id":"f.exp_log_bounds","entity_kind":"formula","title":"指数对数不等式","text":"e^x\\ge x+1,\\qquad x-1\\ge\\ln x\\quad(x>0),\\qquad\\frac1{1+x}<\\ln\\left(1+\\frac1x\\right)<\\frac1x\\quad(x>0)","applicability_conditions":"分别满足对应 x 的实数或正数条件","source_id":"src.math2.textbook_ch02","source_pages":[93],"confirmation":"source_page_confirmed"}
{"id":"f.root.max","entity_kind":"formula","title":"有限项根式最大值","text":"max(a_i)≤(a_1^n+…+a_m^n)^{1/n}≤max(a_i)m^{1/n}","applicability_conditions":"a_i≥0，m 为固定正整数","source_id":"src.math2.textbook_ch02","source_pages":[94],"confirmation":"source_page_confirmed"}
{"id":"f.limit.operations.function","entity_kind":"formula","title":"函数极限四则运算","text":"\\lim_{x\\to a}[f(x)\\pm g(x)]=A\\pm B,\\qquad\\lim_{x\\to a}f(x)g(x)=AB,\\qquad\\lim_{x\\to a}\\frac{f(x)}{g(x)}=\\frac AB","source_id":"src.math2.textbook_ch02","source_pages":[88],"confirmation":"source_page_confirmed","applicability_conditions":"函数极限 A、B 均存在；商式需 B≠0 且 g(x) 在去心邻域内非零"}
{"id":"f.exp_first_order","entity_kind":"formula","title":"指数数列一阶等价","text":"\\left(1+\\frac1n\\right)^n-e\\sim-\\frac{e}{2n}","source_id":"src.math2.textbook_ch02","source_pages":[91],"confirmation":"source_page_confirmed","applicability_conditions":"n\\to\\infty，n 为正整数"}
{"id":"f.trig.lower_bound","entity_kind":"formula","title":"正弦线性下界","text":"\\sin x>\\frac{2}{\\pi}x","source_id":"src.math2.textbook_ch02","source_pages":[92],"confirmation":"source_page_confirmed","applicability_conditions":"0<x<\\frac\\pi2"}
{"id":"f.trig.upper_quarter","entity_kind":"formula","title":"正切线性上界","text":"x<\\tan x<\\frac4\\pi x","source_id":"src.math2.textbook_ch02","source_pages":[92],"confirmation":"source_page_confirmed","applicability_conditions":"0<x<\\frac\\pi4"}
{"id":"f.square_bound","entity_kind":"formula","title":"平方和不等式","text":"|ab|\\le\\frac{a^2+b^2}{2}","source_id":"src.math2.textbook_ch02","source_pages":[92],"confirmation":"source_page_confirmed","applicability_conditions":"a,b 为任意实数"}
{"id":"f.triangle.sum","entity_kind":"formula","title":"多项绝对值三角不等式","text":"|a_1+a_2+\\cdots+a_n|\\le|a_1|+|a_2|+\\cdots+|a_n|","source_id":"src.math2.textbook_ch02","source_pages":[92],"confirmation":"source_page_confirmed","applicability_conditions":"a_1,\\ldots,a_n 为实数，n 为正整数"}
{"id":"f.log_bounds","entity_kind":"formula","title":"对数夹逼不等式","text":"x-1\\ge\\ln x\\quad(x>0),\\qquad\\frac1{1+x}<\\ln\\left(1+\\frac1x\\right)<\\frac1x\\quad(x>0)","source_id":"src.math2.textbook_ch02","source_pages":[93],"confirmation":"source_page_confirmed","applicability_conditions":"第一式 x>0；第二式 x>0"}
{"id":"f.log_one_plus_bounds","entity_kind":"formula","title":"ln(1+x)夹逼","text":"\\frac{x}{1+x}<\\ln(1+x)<x","source_id":"src.math2.textbook_ch02","source_pages":[93],"confirmation":"source_page_confirmed","applicability_conditions":"x>0"}
{"id":"f.exp_lower_bound","entity_kind":"formula","title":"指数下界","text":"e^x\\ge x+1","source_id":"src.math2.textbook_ch02","source_pages":[93],"confirmation":"source_page_confirmed","applicability_conditions":"x 为任意实数"}
{"id":"f.root.sin_cos_piecewise","entity_kind":"formula","title":"正弦余弦根式分段极限","text":"\\lim_{n\\to\\infty}(\\sin^n x+\\cos^n x)^{1/n}=\\begin{cases}\\cos x,&0\\le x\\le\\frac\\pi4\\\\\\sin x,&\\frac\\pi4<x\\le\\frac\\pi2\\end{cases}","source_id":"src.math2.textbook_ch02","source_pages":[94],"confirmation":"source_page_confirmed","applicability_conditions":"0\\le x\\le\\frac\\pi2"}
{"id":"f.root.abs_power_piecewise","entity_kind":"formula","title":"绝对值幂根式分段极限","text":"\\lim_{n\\to\\infty}(1+|x|^{3n})^{1/n}=\\begin{cases}1,&|x|\\le1\\\\|x|^3,&|x|>1\\end{cases}","source_id":"src.math2.textbook_ch02","source_pages":[94],"confirmation":"source_page_confirmed","applicability_conditions":"x 为任意实数"}
