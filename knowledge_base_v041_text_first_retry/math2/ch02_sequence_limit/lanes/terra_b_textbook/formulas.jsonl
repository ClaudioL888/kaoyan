{"id":"f.arithmetic.general","entity_kind":"formula","title":"等差通项","text":"a_n=a_1+(n-1)d","source_id":"src.math2.textbook_ch02","source_pages":[84],"confirmation":"source_page_confirmed"}
{"id":"f.arithmetic.sum","entity_kind":"formula","title":"等差和","text":"S_n=\\frac n2[2a_1+(n-1)d]=\\frac n2(a_1+a_n)","source_id":"src.math2.textbook_ch02","source_pages":[84],"confirmation":"source_page_confirmed"}
{"id":"f.geometric.general","entity_kind":"formula","title":"等比通项","text":"a_n=a_1r^{n-1}","source_id":"src.math2.textbook_ch02","source_pages":[84],"confirmation":"source_page_confirmed"}
{"id":"f.geometric.sum","entity_kind":"formula","title":"等比和","text":"S_n=\\begin{cases}na_1,&r=1\\\\\\frac{a_1(1-r^n)}{1-r},&r\\ne1\\end{cases}","source_id":"src.math2.textbook_ch02","source_pages":[84],"confirmation":"source_page_confirmed"}
{"id":"f.sum.k","entity_kind":"formula","title":"幂和","text":"\\sum_{k=1}^n k=\\frac{n(n+1)}2","source_id":"src.math2.textbook_ch02","source_pages":[84],"confirmation":"source_page_confirmed"}
{"id":"f.sum.k2","entity_kind":"formula","title":"平方和","text":"\\sum_{k=1}^n k^2=\\frac{n(n+1)(2n+1)}6","source_id":"src.math2.textbook_ch02","source_pages":[84],"confirmation":"source_page_confirmed"}
{"id":"f.sum.telescoping","entity_kind":"formula","title":"裂项和","text":"\\sum_{k=1}^n\\frac1{k(k+1)}=1-\\frac1{n+1}","source_id":"src.math2.textbook_ch02","source_pages":[84],"confirmation":"source_page_confirmed"}
{"id":"f.limit.definition","entity_kind":"formula","title":"极限定义","text":"\\forall\\varepsilon>0,\\exists N\\in\\mathbb N_+,n>N\\Rightarrow|x_n-a|<\\varepsilon","source_id":"src.math2.textbook_ch02","source_pages":[85],"confirmation":"source_page_confirmed"}
{"id":"f.abs_limit","entity_kind":"formula","title":"绝对值极限","text":"\\lim x_n=A\\Rightarrow\\lim|x_n|=|A|","source_id":"src.math2.textbook_ch02","source_pages":[86],"confirmation":"source_page_confirmed"}
{"id":"f.limit.operations","entity_kind":"formula","title":"四则运算","text":"\\lim(x_n\\pm y_n)=a\\pm b,\\ \\lim(x_ny_n)=ab,\\ \\lim\\frac{x_n}{y_n}=\\frac ab\\ (b\\ne0)","source_id":"src.math2.textbook_ch02","source_pages":[88],"confirmation":"source_page_confirmed"}
{"id":"f.squeeze","entity_kind":"formula","title":"夹逼定理","text":"y_n\\le x_n\\le z_n,\\ \\lim y_n=\\lim z_n=a\\Rightarrow\\lim x_n=a","source_id":"src.math2.textbook_ch02","source_pages":[91],"confirmation":"source_page_confirmed"}
{"id":"f.squeeze.sum_bounds","entity_kind":"formula","title":"和式夹逼","text":"n u_{\\min}\\le\\sum_{i=1}^n u_i\\le n u_{\\max}","source_id":"src.math2.textbook_ch02","source_pages":[92],"confirmation":"source_page_confirmed"}
{"id":"f.contraction","entity_kind":"formula","title":"压缩映射","text":"|x_{n+1}-a|\\le k|x_n-a|,\\ 0<k<1\\Rightarrow x_n\\to a","source_id":"src.math2.textbook_ch02","source_pages":[97],"confirmation":"source_page_confirmed"}
{"id":"f.speed_ratio","entity_kind":"formula","title":"速度比","text":"I=\\lim_{n\\to\\infty}\\frac{|x_n-a|}{|y_n-a|}","source_id":"src.math2.textbook_ch02","source_pages":[100],"confirmation":"source_page_confirmed"}
{"id":"f.common_ineq","entity_kind":"formula","title":"常用不等式","text":"\\sqrt{ab}\\le\\frac{a+b}{2},\\ |a\\pm b|\\le|a|+|b|","source_id":"src.math2.textbook_ch02","source_pages":[92],"confirmation":"source_page_confirmed"}
{"id":"f.trig_small","entity_kind":"formula","title":"等价无穷小","text":"1-\\cos x\\sim\\frac{x^2}{2}\\ (x\\to0)","source_id":"src.math2.textbook_ch02","source_pages":[94],"confirmation":"source_page_confirmed"}
